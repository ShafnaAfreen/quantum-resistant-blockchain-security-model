# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Hardhat network ---
RPC_URL=http://127.0.0.1:8545

# Private key of the account Hardhat node prints on startup (account #0).
# This is a well-known throwaway test key on the local Hardhat network ONLY.
# Never reuse a key like this on a real network.
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Contract (filled in automatically by scripts/deploy.js) ---
CONTRACT_ADDRESS=

# --- Pallavi's PQC backend (Layer 6) ---
# Point this at the mock service while developing, swap to her real
# FastAPI URL once it's up (same /verify contract either way).
PQC_SERVICE_URL=http://127.0.0.1:8000
